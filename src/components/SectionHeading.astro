---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'left' } = Astro.props;
const alignClass = align === 'center' ? 'items-center text-center' : 'items-start text-left';
---

<div class:list={['flex flex-col gap-3', alignClass]}>
  {eyebrow && (
    <p class="text-xs font-medium tracking-[0.22em] text-sage-600">{eyebrow}</p>
  )}
  <h2 class="font-display text-3xl font-semibold text-bark-900 md:text-4xl">
    {title}
  </h2>
  {description && (
    <p class:list={['max-w-2xl text-bark-500', align === 'center' && 'mx-auto']}>
      {description}
    </p>
  )}
</div>
