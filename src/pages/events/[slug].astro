---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CardImage from '../../components/CardImage.astro';
import EventCard from '../../components/EventCard.astro';
import { formatDate, formatPrice } from '../../utils/format';
import { link } from '../../utils/url';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { data } = event;
const { Content } = await render(event);

const statusLabel = { open: '受付中', waitlist: 'キャンセル待ち', closed: '受付終了' }[data.status];
const statusClass = {
  open: 'bg-sage-100 text-sage-700',
  waitlist: 'bg-clay-200 text-clay-600',
  closed: 'bg-sand text-bark-400',
}[data.status];

const now = new Date();
const others = (await getCollection('events'))
  .filter((e) => e.id !== event.id && e.data.date >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 2);
---

<Base title={data.title} description={data.description}>
  <article class="mx-auto max-w-6xl px-5 py-12 md:py-16">
    <nav class="mb-8 text-sm text-bark-400" aria-label="パンくず">
      <a href={link('/')} class="hover:text-sage-700">ホーム</a>
      <span class="mx-2">/</span>
      <a href={link('/events/')} class="hover:text-sage-700">イベント</a>
      <span class="mx-2">/</span>
      <span class="text-bark-600">{data.title}</span>
    </nav>

    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr]">
      <div>
        <span class={`inline-block rounded-full px-3 py-1 text-xs font-medium ${statusClass}`}>
          {statusLabel}
        </span>
        <h1 class="mt-4 font-display text-3xl font-semibold text-bark-900 md:text-4xl">
          {data.title}
        </h1>
        <p class="mt-4 text-bark-500">{data.description}</p>

        <div class="prose-herb mt-8 text-[1.02rem] text-bark-700">
          <Content />
        </div>
      </div>

      <aside class="h-fit space-y-5 md:sticky md:top-24">
        <CardImage
          src={data.image}
          alt={`${data.title} の様子`}
          ratio="aspect-[4/3]"
          className="rounded-3xl shadow-soft"
        />
        <div class="rounded-3xl border hairline bg-linen p-6 shadow-soft">
          <dl class="space-y-4">
            <div class="flex items-start gap-3">
              <dt class="mt-0.5 shrink-0">
                <svg viewBox="0 0 24 24" class="size-5 text-sage-600" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="18" rx="2" />
                  <path d="M16 2v4M8 2v4M3 10h18" />
                </svg>
              </dt>
              <dd class="text-sm">
                <span class="block text-xs text-bark-400">日程</span>
                <span class="mt-0.5 block font-medium text-bark-800">
                  {formatDate(data.date)}
                  {data.endDate && data.endDate > data.date
                    ? ` 〜 ${formatDate(data.endDate)}`
                    : ''}
                </span>
              </dd>
            </div>
            <div class="flex items-start gap-3">
              <dt class="mt-0.5 shrink-0">
                <svg viewBox="0 0 24 24" class="size-5 text-sage-600" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3 2" />
                </svg>
              </dt>
              <dd class="text-sm">
                <span class="block text-xs text-bark-400">時間</span>
                <span class="mt-0.5 block font-medium text-bark-800">{data.time}</span>
              </dd>
            </div>
            <div class="flex items-start gap-3">
              <dt class="mt-0.5 shrink-0">
                <svg viewBox="0 0 24 24" class="size-5 text-sage-600" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
              </dt>
              <dd class="text-sm">
                <span class="block text-xs text-bark-400">場所</span>
                <span class="mt-0.5 block font-medium text-bark-800">{data.location}</span>
              </dd>
            </div>
            <div class="flex items-start gap-3">
              <dt class="mt-0.5 shrink-0">
                <svg viewBox="0 0 24 24" class="size-5 text-sage-600" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
              </dt>
              <dd class="text-sm">
                <span class="block text-xs text-bark-400">定員</span>
                <span class="mt-0.5 block font-medium text-bark-800">{data.capacity} 名</span>
              </dd>
            </div>
            <div class="flex items-start gap-3 border-t hairline pt-4">
              <dt class="mt-0.5 shrink-0">
                <svg viewBox="0 0 24 24" class="size-5 text-sage-600" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v10M9.5 9.5h3.75a1.75 1.75 0 0 1 0 3.5h-2.5a1.75 1.75 0 0 0 0 3.5H14" />
                </svg>
              </dt>
              <dd class="text-sm">
                <span class="block text-xs text-bark-400">参加費</span>
                <span class="mt-0.5 block font-display text-xl font-semibold text-sage-700">
                  {formatPrice(data.price)}
                </span>
              </dd>
            </div>
          </dl>

          <a
            href={link('/contact/')}
            class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-sage-600 px-6 py-3.5 text-sm font-medium text-cream shadow-soft transition-colors hover:bg-sage-700"
          >
            申し込み・お問い合わせ
          </a>
          <p class="mt-3 text-center text-xs text-bark-400">
            お申し込みはお問い合わせフォームからどうぞ。
          </p>
        </div>
      </aside>
    </div>
  </article>

  {others.length > 0 && (
    <section class="mx-auto max-w-6xl px-5 pb-8 pt-8">
      <h2 class="mb-8 font-display text-2xl font-semibold text-bark-900">
        他のイベント
      </h2>
      <div class="space-y-5">
        {others.map((e, i) => (
          <EventCard
            title={e.data.title}
            slug={e.id}
            date={e.data.date}
            endDate={e.data.endDate}
            time={e.data.time}
            location={e.data.location}
            price={e.data.price}
            description={e.data.description}
            image={e.data.image}
            status={e.data.status}
            seed={i + 1}
          />
        ))}
      </div>
    </section>
  )}
</Base>
