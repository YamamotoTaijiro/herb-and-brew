---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site';
---

<Base title="お問い合わせ" description="イベントの申し込みや、ブレンドに関するお問い合わせはこちらです。">
  <section class="border-b hairline bg-gradient-to-b from-sage-100 to-cream">
    <div class="mx-auto max-w-6xl px-5 py-16 md:py-20">
      <SectionHeading
        eyebrow="CONTACT"
        title="お問い合わせ"
        description="イベントの申し込みや、ブレンドに関するご相談など、お気軽にお問い合わせください。"
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-14 md:py-16">
    <div class="grid gap-10 md:grid-cols-[1fr_1.4fr]">
      <div class="space-y-6">
        <div class="rounded-3xl border hairline bg-linen p-7 shadow-soft">
          <h2 class="font-display text-lg font-semibold text-bark-900">直接メールで</h2>
          <p class="mt-2 text-sm text-bark-500">
            下記アドレスまでお気軽にご連絡ください。
          </p>
          <a
            href={`mailto:${site.email}`}
            class="mt-3 inline-block break-all text-sm font-medium text-sage-700 hover:underline"
          >
            {site.email}
          </a>
        </div>
        <div class="rounded-3xl bg-sage-50 p-7">
          <h2 class="font-display text-lg font-semibold text-bark-900">店舗</h2>
          <p class="mt-2 text-sm leading-relaxed text-bark-600">{site.address}</p>
          <p class="mt-2 text-sm text-bark-500">水曜 〜 日曜 11:00 - 19:00</p>
        </div>
      </div>

      <form id="contact-form" class="rounded-3xl border hairline bg-linen p-7 shadow-soft md:p-9">
        <div class="grid gap-5">
          <div>
            <label for="name" class="mb-1.5 block text-sm font-medium text-bark-700">
              お名前 <span class="text-clay-500">*</span>
            </label>
            <input
              id="name"
              name="name"
              type="text"
              required
              class="w-full rounded-xl border hairline bg-cream px-4 py-3 text-sm text-bark-800 outline-none transition-colors focus:border-sage-400 focus:ring-2 focus:ring-sage-200"
              placeholder="山田 花子"
            />
          </div>

          <div>
            <label for="email" class="mb-1.5 block text-sm font-medium text-bark-700">
              メールアドレス <span class="text-clay-500">*</span>
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="w-full rounded-xl border hairline bg-cream px-4 py-3 text-sm text-bark-800 outline-none transition-colors focus:border-sage-400 focus:ring-2 focus:ring-sage-200"
              placeholder="you@example.com"
            />
          </div>

          <div>
            <label for="subject" class="mb-1.5 block text-sm font-medium text-bark-700">
              件名
            </label>
            <select
              id="subject"
              name="subject"
              class="w-full rounded-xl border hairline bg-cream px-4 py-3 text-sm text-bark-800 outline-none transition-colors focus:border-sage-400 focus:ring-2 focus:ring-sage-200"
            >
              <option>イベントの申し込み</option>
              <option>ブレンドについて</option>
              <option>卸・業務用について</option>
              <option>その他</option>
            </select>
          </div>

          <div>
            <label for="message" class="mb-1.5 block text-sm font-medium text-bark-700">
              ご内容 <span class="text-clay-500">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full resize-y rounded-xl border hairline bg-cream px-4 py-3 text-sm text-bark-800 outline-none transition-colors focus:border-sage-400 focus:ring-2 focus:ring-sage-200"
              placeholder="お問い合わせ内容をご記入ください。"
            ></textarea>
          </div>

          <button
            type="submit"
            class="mt-2 inline-flex items-center justify-center rounded-full bg-sage-600 px-8 py-3.5 text-sm font-medium text-cream shadow-soft transition-colors hover:bg-sage-700"
          >
            送信する
          </button>
          <p class="text-center text-xs text-bark-400">
            送信するとメールアプリが開きます（静的サイトのため）。
            フォームサービスへの差し替えも可能です。
          </p>
        </div>
      </form>
    </div>
  </section>
</Base>

<script define:vars={{ email: site.email }} is:inline>
  const form = document.getElementById('contact-form');
  if (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      const data = new FormData(form);
      const subject = encodeURIComponent('[' + data.get('subject') + '] ' + data.get('name'));
      const body = encodeURIComponent(
        'お名前: ' + data.get('name') + '\nメール: ' + data.get('email') + '\n\n' + data.get('message')
      );
      window.location.href = 'mailto:' + email + '?subject=' + subject + '&body=' + body;
    });
  }
</script>
